# Nido — pliki wykluczone z indeksowania Cursor (składnia jak .gitignore)
# https://cursor.com/docs/context/ignore-files

# --- Zależności i menedżery pakietów ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Lockfile — duży, rzadko potrzebny przy edycji kodu (~300k+ linii)
pnpm-lock.yaml
package-lock.json
yarn.lock

# --- Buildy i artefakty Next.js ---
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# --- Testy i raporty ---
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
vitest.config.ts.timestamp-*

# --- Cache narzędzi ---
.turbo/
.cache/
.eslintcache
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Środowisko i sekrety (nigdy nie indeksować) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# --- Vercel / deploy ---
.vercel/

# --- System i IDE ---
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
*~

# --- Git (historia niepotrzebna w kontekście kodu) ---
.git/

# --- Zasoby statyczne (SVG starter Next — małe, ale bez wartości dla AI) ---
public/*.svg
